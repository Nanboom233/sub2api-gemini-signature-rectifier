@@ -2,10 +2,229 @@ package service
 
 import (
+	"encoding/base64"
 	"encoding/json"
+	"net/url"
+	"strings"
+	"unicode"
 
 	"github.com/Wei-Shaw/sub2api/internal/pkg/antigravity"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/geminicli"
+	"google.golang.org/protobuf/encoding/protowire"
 )
 
+// isGeminiNativeSignatureRelatedError matches only the extracted upstream error message.
+func isGeminiNativeSignatureRelatedError(body []byte) bool {
+	message := strings.Map(func(r rune) rune {
+		if r == '_' || unicode.IsSpace(r) {
+			return -1
+		}
+		return unicode.ToLower(r)
+	}, extractUpstreamErrorMessage(body))
+	return strings.Contains(message, "thoughtsignature")
+}
+
+// isGeminiNativeVertexTarget classifies the builder target without changing URL validation.
+func isGeminiNativeVertexTarget(account *Account, action string) bool {
+	if account.IsVertexServiceAccount() {
+		return true
+	}
+	if account.Type != AccountTypeAPIKey && account.Type != AccountTypeOAuth {
+		return false
+	}
+	if account.Type == AccountTypeOAuth && action != "countTokens" && strings.TrimSpace(account.GetCredential("project_id")) != "" {
+		return false
+	}
+	target, err := url.Parse(account.GetGeminiBaseURL(geminicli.AIStudioBaseURL))
+	if err != nil {
+		return false
+	}
+	host := strings.ToLower(target.Hostname())
+	return host == "aiplatform.googleapis.com" || host == "aiplatform.us.rep.googleapis.com" ||
+		host == "aiplatform.eu.rep.googleapis.com" ||
+		(strings.HasSuffix(host, "-aiplatform.googleapis.com") && host != "-aiplatform.googleapis.com")
+}
+
+// replayGeminiNativeThoughtSignature permits compatible envelopes and first-call bypass values.
+func replayGeminiNativeThoughtSignature(raw string, allowBareTink, allowBypass bool) string {
+	sig := strings.TrimSpace(raw)
+	if sig == "" {
+		return ""
+	}
+	if sig == geminiDummyThoughtSignature || sig == "context_engineering_is_the_way_to_go" {
+		if allowBypass {
+			return sig
+		}
+		return ""
+	}
+	decoded, err := base64.StdEncoding.DecodeString(sig)
+	if err != nil {
+		decoded, err = base64.RawStdEncoding.DecodeString(sig)
+	}
+	if err != nil || len(decoded) == 0 {
+		return ""
+	}
+	if allowBareTink && len(decoded) >= 21 && decoded[0] == 0x01 &&
+		[4]byte(decoded[1:5]) == [4]byte{0x8f, 0x3d, 0x6b, 0x5f} {
+		return sig
+	}
+	number, wireType, size := protowire.ConsumeTag(decoded)
+	if size < 0 || number != 2 || wireType != protowire.BytesType {
+		return ""
+	}
+	container, consumed := protowire.ConsumeBytes(decoded[size:])
+	if consumed < 0 || size+consumed != len(decoded) {
+		return ""
+	}
+	number, wireType, size = protowire.ConsumeTag(container)
+	if size < 0 || number != 1 || wireType != protowire.BytesType {
+		return ""
+	}
+	value, consumed := protowire.ConsumeBytes(container[size:])
+	if consumed < 0 || size+consumed != len(container) || len(value) == 0 {
+		return ""
+	}
+	return sig
+}
+
+// hasPartKey checks either spelling of a direct Part key.
+func hasPartKey(part map[string]json.RawMessage, a, b string) bool {
+	_, hasA := part[a]
+	_, hasB := part[b]
+	return hasA || hasB
+}
+
+// sanitizeGeminiNativeThoughtSignatures edits direct Part metadata and groups retained calls.
+// Force mode clears rejected signatures and true thought flags on non-call Parts.
+func sanitizeGeminiNativeThoughtSignatures(body []byte, allowBareTink, force bool) ([]byte, bool) {
+	var request map[string]json.RawMessage
+	if err := json.Unmarshal(body, &request); err != nil {
+		return body, false
+	}
+	var contents []json.RawMessage
+	if err := json.Unmarshal(request["contents"], &contents); err != nil {
+		return body, false
+	}
+	changed := false
+	cleanedContents := make([]json.RawMessage, 0, len(contents))
+	for _, rawContent := range contents {
+		var content map[string]json.RawMessage
+		if err := json.Unmarshal(rawContent, &content); err != nil {
+			return body, false
+		}
+		var parts []json.RawMessage
+		if err := json.Unmarshal(content["parts"], &parts); err != nil {
+			return body, false
+		}
+		eligibleRole := true
+		if rawRole, ok := content["role"]; ok {
+			var role *string
+			eligibleRole = json.Unmarshal(rawRole, &role) == nil && role != nil && (*role == "model" || *role == "")
+		}
+		firstCallSeen := false
+		contentChanged := false
+		cleanedParts := make([]json.RawMessage, 0, len(parts))
+		for _, rawPart := range parts {
+			var part map[string]json.RawMessage
+			if err := json.Unmarshal(rawPart, &part); err != nil {
+				return body, false
+			}
+			if hasPartKey(part, "toolCall", "tool_call") || hasPartKey(part, "toolResponse", "tool_response") {
+				cleanedParts = append(cleanedParts, rawPart)
+				continue
+			}
+			hasResponse := hasPartKey(part, "functionResponse", "function_response")
+			if !force && !eligibleRole && !hasResponse {
+				cleanedParts = append(cleanedParts, rawPart)
+				continue
+			}
+			hasCall := hasPartKey(part, "functionCall", "function_call") && !hasResponse
+			rawSignature, camelSignature := part["thoughtSignature"]
+			snakeValue, snakeSignature := part["thought_signature"]
+			if !camelSignature {
+				rawSignature = snakeValue
+			}
+			var signature string
+			if rawSignature != nil {
+				_ = json.Unmarshal(rawSignature, &signature)
+			}
+			var thought bool
+			_ = json.Unmarshal(part["thought"], &thought)
+			replaySignature := ""
+			if !hasResponse && !force {
+				replaySignature = replayGeminiNativeThoughtSignature(signature, allowBareTink, hasCall && !firstCallSeen)
+			}
+			if hasCall && !firstCallSeen && replaySignature == "" {
+				replaySignature = geminiDummyThoughtSignature
+			}
+			partChanged := false
+			if replaySignature != "" {
+				if !camelSignature || signature != replaySignature || snakeSignature {
+					part["thoughtSignature"], _ = json.Marshal(replaySignature)
+					delete(part, "thought_signature")
+					partChanged = true
+				}
+			} else if camelSignature || snakeSignature {
+				delete(part, "thoughtSignature")
+				delete(part, "thought_signature")
+				partChanged = true
+			}
+			if force && !hasCall && thought {
+				delete(part, "thought")
+				thought = false
+				partChanged = true
+			}
+			if partChanged {
+				var text string
+				emptyText := len(part) == 1 && json.Unmarshal(part["text"], &text) == nil && text == ""
+				if len(part) == 0 || emptyText {
+					contentChanged = true
+					continue
+				}
+				var err error
+				rawPart, err = json.Marshal(part)
+				if err != nil {
+					return body, false
+				}
+				contentChanged = true
+			}
+			cleanedParts = append(cleanedParts, rawPart)
+			if !hasResponse && (hasCall || !thought) {
+				firstCallSeen = hasCall
+			}
+		}
+		if contentChanged && len(cleanedParts) == 0 {
+			changed = true
+			continue
+		}
+		if contentChanged {
+			var err error
+			content["parts"], err = json.Marshal(cleanedParts)
+			if err != nil {
+				return body, false
+			}
+			rawContent, err = json.Marshal(content)
+			if err != nil {
+				return body, false
+			}
+			changed = true
+		}
+		cleanedContents = append(cleanedContents, rawContent)
+	}
+	if !changed || len(cleanedContents) == 0 {
+		return body, false
+	}
+	var err error
+	request["contents"], err = json.Marshal(cleanedContents)
+	if err != nil {
+		return body, false
+	}
+	cleaned, err := json.Marshal(request)
+	if err != nil {
+		return body, false
+	}
+	return cleaned, true
+}
